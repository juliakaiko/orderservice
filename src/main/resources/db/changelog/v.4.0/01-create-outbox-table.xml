<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd
            http://www.liquibase.org/xml/ns/pro
            http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd">

    <changeSet id="create-outbox-table" author="julia_kaiko">
        <createTable tableName="outbox_table">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="aggregate_id" type="varchar(50)"/>
            <column name="event_type" type="varchar(50)"/>
            <column name="payload" type="jsonb"/>
            <column name="status" type="varchar(20)"/>
            <column name="trace_id" type="varchar(100)"/>
            <column name="source_service" type="varchar(100)"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="processed_at" type="timestamp"/>
        </createTable>

        <createIndex tableName="outbox_table"
                     indexName="idx_outbox_status_created">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="outbox_table"
                     indexName="idx_outbox_status_updated">
            <column name="status"/>
            <column name="updated_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
